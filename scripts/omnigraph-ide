#!/bin/bash
# =============================================================================
#  omnigraph-ide — prepara o projeto para usar com a IA da sua IDE gastando
#  MENOS TOKENS. Gera o mapa e registra o OmniGraph no seu assistente
#  (Claude, Cursor, Copilot, VSCode...). Depois, o assistente consulta o mapa
#  em vez de ler todos os arquivos.
#
#  Uso (na pasta do seu projeto):  omnigraph-ide
# =============================================================================
set -uo pipefail
[ -f "$HOME/.omnigraph_env" ] && . "$HOME/.omnigraph_env"

alvo="${1:-.}"
roxo=$'\033[1;35m'; verde=$'\033[32m'; amarelo=$'\033[33m'; zero=$'\033[0m'

OG="$(command -v omnigraph 2>/dev/null || true)"
[ -z "$OG" ] && [ -x "$HOME/.local/bin/omnigraph" ] && OG="$HOME/.local/bin/omnigraph"
if [ -z "$OG" ]; then
  echo "omnigraph não encontrado. Rode o instalador primeiro (ou abra um terminal novo)." >&2
  exit 1
fi
MAPA="$(command -v omnigraph-mapa 2>/dev/null || echo "$HOME/.local/bin/omnigraph-mapa")"

printf "${roxo}▸ Preparando o projeto para a IA da sua IDE${zero}\n"

# mapa de um workspace: pasta acima com omnigraph-out (para antes da pasta pessoal)
mapa_acima() {
  local d casa
  d="$(cd "$1" 2>/dev/null && pwd -P)" || return 1
  casa="$(cd "$HOME" 2>/dev/null && pwd -P)"
  while :; do
    d="$(dirname "$d")"
    { [ "$d" = "/" ] || [ "$d" = "$casa" ]; } && return 1
    [ -f "$d/omnigraph-out/graph.json" ] && { printf '%s\n' "$d"; return 0; }
  done
}

# 1) garante o mapa (usa o omnigraph-mapa: barra de progresso, IA e fallback)
if [ -f "$alvo/omnigraph-out/graph.json" ]; then
  printf "  ${verde}✓${zero} mapa já existe (use 'omnigraph-mapa' para atualizar)\n"
elif acima="$(mapa_acima "$alvo")"; then
  printf "  ${verde}✓${zero} usando o mapa que já existe em %s\n" "$acima"
else
  if [ -x "$MAPA" ]; then
    "$MAPA" "$alvo" || { printf "${amarelo}! não consegui gerar o mapa${zero}\n" >&2; exit 1; }
  else
    ( cd "$alvo" && "$OG" extract . >/dev/null 2>&1 && "$OG" cluster-only . >/dev/null 2>&1 ) \
      || { printf "${amarelo}! não consegui gerar o mapa${zero}\n" >&2; exit 1; }
  fi
fi

# 2) registra o OmniGraph no assistente/IDE
printf "${roxo}▸ Registrando o OmniGraph no seu assistente…${zero}\n"
( cd "$alvo" && "$OG" install )
# 'install' só grava a skill global. É a regra no CLAUDE.md do projeto e o hook
# que fazem o Claude Code realmente consultar o mapa em vez de sair lendo arquivos.
existe() { for p in "$@"; do [ -e "$p" ] && return 0; done; return 1; }
# O plugin do Claude (VS Code, Cursor, Antigravity...) traz o próprio Claude Code
# e não coloca 'claude' no PATH, então procura também pela extensão instalada.
if command -v claude >/dev/null 2>&1 || existe "$HOME/.claude" \
    "$HOME"/.antigravity*/extensions/anthropic.claude-code-* \
    "$HOME"/.vscode/extensions/anthropic.claude-code-* \
    "$HOME"/.cursor/extensions/anthropic.claude-code-* \
    "$HOME"/.windsurf/extensions/anthropic.claude-code-*; then
  ( cd "$alvo" && "$OG" claude install --local ) >/dev/null \
    && printf "  ${verde}✓${zero} Claude Code configurado só nesta máquina (fora do git)\n"
fi
if command -v cursor >/dev/null 2>&1 || [ -d "$HOME/.cursor" ] || [ -d "/Applications/Cursor.app" ]; then
  ( cd "$alvo" && "$OG" cursor install --local ) >/dev/null \
    && printf "  ${verde}✓${zero} Cursor configurado só nesta máquina (fora do git)\n"
fi
if command -v code >/dev/null 2>&1 || [ -d "$HOME/.vscode" ] || [ -d "/Applications/Visual Studio Code.app" ]; then
  ( cd "$alvo" && "$OG" vscode install --local ) >/dev/null \
    && printf "  ${verde}✓${zero} VS Code (Copilot) configurado só nesta máquina (fora do git)\n"
fi
# agente nativo do Antigravity (lê .agents/rules)
if command -v antigravity >/dev/null 2>&1 || existe /Applications/Antigravity*.app \
    "$HOME/.gemini/antigravity" "$HOME"/.antigravity*; then
  ( cd "$alvo" && "$OG" antigravity install --local ) >/dev/null \
    && printf "  ${verde}✓${zero} Antigravity configurado só nesta máquina (fora do git)\n"
fi

# 3) git hook: mantém o mapa atualizado sozinho a cada commit (se for repo git)
if [ -d "$alvo/.git" ]; then
  ( cd "$alvo" && "$OG" hook install ) >/dev/null 2>&1 \
    && printf "  ${verde}✓${zero} o mapa vai se atualizar sozinho a cada commit\n"
fi

printf "\n${verde}✓ Pronto!${zero} Não precisa deixar nenhum servidor rodando.\n"
echo "  Na sua IDE/assistente (Claude, Cursor, Copilot, VSCode...):"
echo "    • pergunte sobre o projeto normalmente, ou digite  /omnigraph"
echo "    • ele consulta o MAPA (poucos tokens) em vez de ler todos os arquivos"
echo
echo "  Atualizar o mapa manualmente (depois de mexer no código):  omnigraph update ."
