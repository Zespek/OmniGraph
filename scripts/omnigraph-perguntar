#!/bin/bash
# =============================================================================
#  omnigraph-perguntar — pergunte, em português, como algo do projeto funciona.
#  Usa a IA local sobre o mapa já gerado (não precisa saber de código).
#
#  Uso (na pasta do seu projeto):
#      omnigraph-perguntar "como funciona o pagamento?"
#      omnigraph-perguntar "onde o login valida a senha?" /caminho/do/projeto
# =============================================================================
set -uo pipefail

# carrega PATH e IA local (OLLAMA_*) mesmo se o terminal não tiver recarregado
[ -f "$HOME/.omnigraph_env" ] && . "$HOME/.omnigraph_env"

pergunta="${1:-}"
alvo="${2:-.}"

roxo=$'\033[1;35m'; verde=$'\033[32m'; amarelo=$'\033[33m'; zero=$'\033[0m'

if [ -z "$pergunta" ]; then
  echo "Uso: omnigraph-perguntar \"sua pergunta\" [pasta do projeto]"
  echo "Ex.: omnigraph-perguntar \"como funciona o pagamento?\""
  exit 1
fi

OG="$(command -v omnigraph 2>/dev/null || true)"
[ -z "$OG" ] && [ -x "$HOME/.local/bin/omnigraph" ] && OG="$HOME/.local/bin/omnigraph"
if [ -z "$OG" ]; then
  echo "omnigraph não encontrado. Rode o instalador primeiro (ou abra um terminal novo)." >&2
  exit 1
fi

if [ ! -f "$alvo/omnigraph-out/graph.json" ]; then
  printf "${amarelo}Ainda não há um mapa nesta pasta.${zero}\n"
  echo "Gere o mapa primeiro (na pasta do projeto):"
  echo "    omnigraph-mapa"
  exit 1
fi

# a IA local está de pé?  se instalada mas parada, sobe sozinha (não precisa saber rodar)
ia_disponivel() { h="${OLLAMA_HOST:-localhost:11434}"; curl -s -m 3 "http://$h/api/tags" >/dev/null 2>&1; }
if ! ia_disponivel && command -v ollama >/dev/null 2>&1; then
  printf "${roxo}▸${zero} iniciando a IA local (Ollama), aguarde"
  case "$(uname -s)" in
    Darwin) open -a Ollama >/dev/null 2>&1 || (ollama serve >/dev/null 2>&1 &) ;;
    *)      (ollama serve >/dev/null 2>&1 &) ;;
  esac
  n=0; while [ "$n" -lt 30 ]; do ia_disponivel && break; printf "."; sleep 1; n=$(( n + 1 )); done
  printf "\n"
fi
if ! ia_disponivel; then
  printf "${amarelo}A IA local não está ativa — a resposta pode ficar limitada.${zero}\n"
  echo "Se não instalou o Ollama, rode o instalador de novo para ativar a IA."
fi

printf "${roxo}▸ Pergunta:${zero} %s\n" "$pergunta"

# roda uma tarefa em segundo plano mostrando um spinner. $1 = arquivo de saída, resto = comando
com_spinner() {
  saida="$1"; shift
  "$@" >"$saida" 2>/dev/null &
  pid=$!; spin='|/-\'; i=0
  while kill -0 "$pid" 2>/dev/null; do
    i=$(( (i + 1) % 4 )); printf "\r${roxo}%s${zero} a IA está pensando…" "${spin:$i:1}"; sleep 0.2
  done
  wait "$pid"; rc=$?; printf "\r\033[K"; return "$rc"
}

# 1) recupera do mapa o trecho relevante (nós/arestas) para a pergunta.
#    --budget maior traz mais contexto (melhora a chance de pegar o certo).
ctx="$(mktemp 2>/dev/null || echo "$HOME/.omnigraph_ctx.tmp")"
( cd "$alvo" && "$OG" query "$pergunta" --budget 6000 ) >"$ctx" 2>/dev/null
if [ ! -s "$ctx" ] || grep -qi "No matching nodes" "$ctx"; then
  printf "${amarelo}Não encontrei nada relacionado a isso no mapa.${zero}\n"
  echo "Tente outras palavras — um nome de função, arquivo ou tela do projeto."
  rm -f "$ctx"; exit 0
fi

# 2) a IA local redige a resposta em português a partir desse contexto
modelo="${OLLAMA_MODEL:-qwen2.5-coder:7b}"
tem_modelo() { curl -s -m 3 "http://${OLLAMA_HOST:-localhost:11434}/api/tags" 2>/dev/null | grep -q "${modelo%%:*}"; }

# chama a IA local pela API (texto limpo, sem os artefatos do 'ollama run')
sintetizar() {  # $1 = arquivo com o prompt ; imprime a resposta
  python3 - "$modelo" "${OLLAMA_HOST:-localhost:11434}" "$1" <<'PY' 2>/dev/null
import sys, json, urllib.request
model, host, pf = sys.argv[1], sys.argv[2], sys.argv[3]
prompt = open(pf, encoding="utf-8").read()
data = json.dumps({"model": model, "prompt": prompt, "stream": False}).encode()
req = urllib.request.Request("http://%s/api/generate" % host, data=data,
                            headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=180) as r:
        sys.stdout.write(json.load(r).get("response", "").strip())
except Exception:
    sys.exit(1)
PY
}

if ia_disponivel && command -v python3 >/dev/null 2>&1 && tem_modelo; then
  pf="$(mktemp 2>/dev/null || echo "$HOME/.omnigraph_prompt.tmp")"
  {
    printf '%s\n\n' "Você explica projetos de software em português claro. Baseie-se SOMENTE no MAPA e no CÓDIGO abaixo (MAPA: NODE = parte do código, EDGE = ligação; \"calls\" = uma função chama outra). REGRAS: NÃO invente fluxos, endpoints, telas ou regras que não estejam no CÓDIGO. Se o material não contiver o que a pergunta pede, responda exatamente: 'Não encontrei isso no mapa deste projeto. Para perguntas de fluxo/regra de negócio, valide direto no código ou pergunte à IA da sua IDE (com o OmniGraph registrado), que lê o código e responde melhor.' Caso contrário, responda em 2 a 6 frases, citando funções/arquivos reais do código."
    printf 'PERGUNTA: %s\n\nMAPA (nós e ligações):\n' "$pergunta"
    cat "$ctx"
    # inclui o CÓDIGO real dos arquivos que a busca apontou (o pulo do gato)
    printf '\n\nCÓDIGO das partes citadas:\n'
    grep -oE 'src=[^] ]+' "$ctx" 2>/dev/null | sed 's/src=//' | sort -u | head -6 | while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$alvo/$f" ] && { printf '\n----- %s -----\n' "$f"; sed -n '1,160p' "$alvo/$f"; }
    done
    printf '\n\nRESPOSTA (em português, baseada no código acima):'
  } > "$pf"
  resp="$(mktemp 2>/dev/null || echo "$HOME/.omnigraph_resp.tmp")"
  com_spinner "$resp" sintetizar "$pf"
  if [ -s "$resp" ]; then
    printf "${verde}▸ Resposta:${zero}\n"
    cat "$resp"; echo
  else
    printf "${amarelo}A IA não redigiu a resposta — mostrando as partes do mapa:${zero}\n"
    cat "$ctx"
  fi
  rm -f "$resp" "$pf"
else
  printf "${amarelo}A IA local não está ativa — mostrando as partes do mapa relacionadas:${zero}\n"
  cat "$ctx"
  echo
  echo "Para respostas em português, ative a IA (instale o Ollama e rode o instalador de novo)."
fi
rm -f "$ctx"
