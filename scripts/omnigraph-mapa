#!/bin/bash
# =============================================================================
#  omnigraph-mapa — gera o mapa do projeto mostrando o progresso em %.
#
#  Uso (na pasta do seu projeto):
#      omnigraph-mapa            # com IA local (padrão)
#      omnigraph-mapa .          # igual ao de cima
#      omnigraph-mapa --code-only  # sem IA (mais rápido, sempre funciona)
#      omnigraph-mapa /caminho/do/projeto
#
#  Roda 'extract' + 'cluster-only' e desenha uma barra. Se a IA falhar,
#  refaz sozinho no modo sem-IA para o mapa sair de qualquer jeito.
# =============================================================================
set -uo pipefail

alvo="."
code_only=0
incluir_tudo=0
for a in "$@"; do
  case "$a" in
    --code-only)          code_only=1 ;;
    --tudo|--no-gitignore) incluir_tudo=1 ;;   # inclui arquivos que o .gitignore esconderia
    -*)                    : ;;                 # ignora outras flags desconhecidas
    *)                     alvo="$a" ;;
  esac
done

# acha o omnigraph mesmo se o PATH não estiver carregado nesta sessão
OG="$(command -v omnigraph 2>/dev/null || true)"
[ -z "$OG" ] && [ -x "$HOME/.local/bin/omnigraph" ] && OG="$HOME/.local/bin/omnigraph"
if [ -z "$OG" ]; then
  echo "omnigraph não encontrado. Rode o instalador primeiro (ou abra um terminal novo)." >&2
  exit 1
fi

roxo=$'\033[1;35m'; verde=$'\033[32m'; amarelo=$'\033[33m'; zero=$'\033[0m'

barra() {  # $1 = porcentagem  $2 = rótulo
  p="$1"; label="$2"; n=$(( p / 5 ))
  cheio=""; vazio=""; i=0
  while [ "$i" -lt "$n" ];  do cheio="$cheio#"; i=$(( i + 1 )); done
  while [ "$i" -lt 20 ]; do vazio="$vazio-"; i=$(( i + 1 )); done
  printf "\r${roxo}[%s%s]${zero} %3d%%  %s\033[K" "$cheio" "$vazio" "$p" "$label"
}

# roda o extract: mostra a % e GRAVA toda a saída em $LOG (para mostrar o erro
# real se falhar). Retorna o status real do extract.
rodar_extract() {  # $1 = 1 para --code-only
  co="$1"
  set -- extract "$alvo"
  [ "$co" = 1 ] && set -- "$@" --code-only
  [ "${incluir_tudo:-0}" = 1 ] && set -- "$@" --no-gitignore
  { "$OG" "$@"; } 2>&1 | tee "$LOG" | while IFS= read -r line; do
        case "$line" in
          *scanning*)                 barra 5   "lendo os arquivos do projeto…" ;;
          *"AST extraction on"*)      barra 15  "analisando o código…" ;;
          *"semantic extraction on"*) barra 22  "a IA está entendendo o projeto… (pode levar alguns minutos)" ;;
          *chunk*done*)
              xy="${line#*chunk }"; x="${xy%%/*}"; rest="${xy#*/}"; y="${rest%% *}"
              case "$x$y" in
                *[!0-9]*|"") : ;;
                *) [ "$y" -gt 0 ] && barra $(( 22 + x * 63 / y )) "IA processando (parte $x de $y)…" ;;
              esac ;;
          *wrote*graph.json*)         barra 90  "dados do mapa prontos" ;;
        esac
      done
  return "${PIPESTATUS[0]}"
}

# mostra o erro real (últimas linhas da saída do extract)
mostrar_erro_real() {
  printf "\n${amarelo}Erro real do extract:${zero}\n"
  tail -n 25 "$LOG" 2>/dev/null | sed 's/^/    /'
}

# a IA local (Ollama) está respondendo?
ia_disponivel() {
  h="${OLLAMA_HOST:-localhost:11434}"
  curl -s -m 3 "http://$h/api/tags" >/dev/null 2>&1
}

# garante a IA de pé: se estiver parada mas instalada, SOBE ela sozinha
# (o usuário não precisa saber rodar 'ollama serve').
garantir_ollama() {
  ia_disponivel && return 0
  command -v ollama >/dev/null 2>&1 || return 1   # nem instalada
  printf "${roxo}▸${zero} iniciando a IA local (Ollama), aguarde"
  case "$(uname -s)" in
    Darwin) open -a Ollama >/dev/null 2>&1 || (ollama serve >/dev/null 2>&1 &) ;;  # o app gerencia o servidor
    *)      (ollama serve >/dev/null 2>&1 &) ;;
  esac
  n=0
  while [ "$n" -lt 30 ]; do
    if ia_disponivel; then printf " ok\n"; return 0; fi
    printf "."; sleep 1; n=$(( n + 1 ))
  done
  printf " (não subiu)\n"
  return 1
}

rodar_cluster() {
  "$OG" cluster-only "$alvo" 2>&1 | while IFS= read -r line; do
    case "$line" in
      *Re-clustering*) barra 93  "montando o gráfico…" ;;
      *Labeling*)      barra 96  "nomeando as áreas…" ;;
      *Done*)          barra 100 "pronto!" ;;
    esac
  done
  return "${PIPESTATUS[0]}"
}

LOG="$(mktemp 2>/dev/null || echo "$HOME/.omnigraph_mapa.log")"

# garante que a pasta de saída não seja commitada sem querer: um 'git add -A'
# comum pegaria ela, e um colega que já gerou o mapa localmente teria o
# 'git pull' ABORTADO por arquivos não rastreados que seriam sobrescritos.
garantir_gitignore() {
  raiz="$(git -C "$alvo" rev-parse --show-toplevel 2>/dev/null)" || return 0
  saida="${OMNIGRAPH_OUT:-omnigraph-out}"
  gi="$raiz/.gitignore"
  if [ -f "$gi" ] && grep -qE "^/?${saida}/?\$" "$gi" 2>/dev/null; then
    return 0
  fi
  [ -f "$gi" ] && [ -s "$gi" ] && [ -n "$(tail -c1 "$gi")" ] && printf '\n' >> "$gi"
  printf '%s/\n' "$saida" >> "$gi"
  echo "${roxo}▸${zero} adicionado '${saida}/' ao .gitignore (evita commitar o mapa sem querer)"
}
garantir_gitignore

echo "${roxo}▸ Gerando o mapa de:${zero} $alvo"

# se não pediram --code-only, tenta garantir a IA de pé (subindo o Ollama se
# preciso). Se mesmo assim não houver IA, gera direto do código, sem erro.
if [ "$code_only" -ne 1 ] && ! garantir_ollama; then
  printf "${amarelo}! IA local não detectada — gerando o mapa direto do código (rápido).${zero}\n"
  code_only=1
fi

barra 0 "iniciando…"
rodar_extract "$code_only"; ex=$?

# fallback: se tentou com IA e falhou, refaz sem IA para o mapa sair mesmo assim
if [ "$ex" -ne 0 ] && [ "$code_only" -ne 1 ]; then
  printf "\n${amarelo}! A IA local falhou — gerando o mapa sem IA (modo seguro)…${zero}\n"
  code_only=1
  barra 0 "iniciando (sem IA)…"
  rodar_extract 1; ex=$?
fi

if [ "$ex" -ne 0 ]; then
  if grep -qE "graph is empty|found 0 code, 0 docs" "$LOG" 2>/dev/null; then
    printf "\n${amarelo}! Nenhum arquivo de projeto reconhecido nesta pasta.${zero}\n" >&2
    echo "  Você está na pasta certa? Ela precisa conter o código-fonte." >&2
    echo "    • veja o que tem aqui com:   ls" >&2
    echo "    • se o código está numa subpasta, entre nela e rode de novo" >&2
    echo "    • se os arquivos existem mas há um .gitignore, tente incluir tudo:" >&2
    echo "        omnigraph-mapa --tudo" >&2
  else
    printf "\n${amarelo}! Não consegui gerar o mapa.${zero}\n" >&2
    mostrar_erro_real >&2
    echo >&2
    echo "Copie o 'Erro real' acima e me mande." >&2
  fi
  rm -f "$LOG"
  exit 1
fi
rm -f "$LOG"

rodar_cluster

# ativa a atualização automática (git hooks de post-commit/checkout/merge) para
# o mapa não ficar parado nesta primeira geração, silencioso e nunca falha o
# resto do script (pasta sem git, por exemplo, é comum e não é um erro aqui).
( cd "$alvo" && "$OG" hook install ) >/dev/null 2>&1 || true

# .gitignore/.gitattributes recém-criados e ainda não commitados: se cada
# colega gerar o mapa por conta própria, cada um cria sua própria cópia sem
# rastreamento, e o primeiro a subir um commit trava o 'git pull' de todo
# mundo (arquivo não rastreado seria sobrescrito pelo merge).
raiz_git="$(git -C "$alvo" rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$raiz_git" ]; then
  pendentes="$(git -C "$raiz_git" status --porcelain -- .gitignore .gitattributes 2>/dev/null | grep '^??' | awk '{print $2}')"
  if [ -n "$pendentes" ]; then
    echo
    echo "${amarelo}! Commite estes arquivos e avise o time (evita travar o 'git pull' de quem já gerou o mapa):${zero}"
    echo "$pendentes" | sed 's/^/    /'
  fi
fi

html="$alvo/omnigraph-out/graph.html"

# grafo grande (>5000 nós): o cluster-only pula o graph.html. Gera então a
# visão agregada por comunidades, que sempre produz um HTML utilizável.
if [ ! -f "$html" ]; then
  printf "\n${roxo}▸${zero} projeto grande: gerando a visão por comunidades…\n"
  ( cd "$alvo" && "$OG" export html ) >/dev/null 2>&1 || true
fi

if [ -f "$html" ]; then
  printf "\n${verde}✓ Mapa pronto:${zero} %s\n" "$html"
  case "$(uname -s)" in
    Darwin) open "$html" >/dev/null 2>&1 || true ;;
    Linux)  xdg-open "$html" >/dev/null 2>&1 || true ;;
  esac
else
  printf "\n${amarelo}! Os dados do mapa foram gerados (graph.json e GRAPH_REPORT.md), mas não consegui criar o graph.html.${zero}\n" >&2
  echo "  Tente, na pasta do projeto:  omnigraph export html" >&2
fi
